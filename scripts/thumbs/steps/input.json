  "file-dropzone": [
    {
      "do": "hover",
      "sel": ".inp-drop",
      "at": [
        0.5,
        0.2
      ],
      "ms": 400
    },
    {
      "do": "eval",
      "js": "(() => { const z = document.querySelector('#shot .inp-drop'); const dt = new DataTransfer(); window.__dt = dt; dt.items.add(new File([new Uint8Array(248000)], '여행 사진.jpg', { type: 'image/jpeg' })); dt.items.add(new File([new Uint8Array(1300000)], '견적서.pdf', { type: 'application/pdf' })); z.dispatchEvent(new DragEvent('dragenter', { bubbles: true, cancelable: true, dataTransfer: dt })); z.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: dt })); })()"
    },
    {
      "do": "hover",
      "sel": ".inp-drop",
      "at": [
        0.5,
        0.55
      ],
      "ms": 700
    },
    {
      "do": "poster"
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "eval",
      "js": "(() => { const z = document.querySelector('#shot .inp-drop'); z.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: window.__dt })); })()"
    },
    {
      "do": "wait",
      "ms": 900
    }
  ],
